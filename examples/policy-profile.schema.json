{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/illicoman/sentinel-pilot/examples/policy-profile.schema.json",
  "title": "Sentinel pilot policy profile public v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile"],
  "properties": {
    "profile": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$"
    },
    "protectedBranches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9._/-]+$"
      }
    },
    "approvalRequiredFor": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "WRITE_FILE",
          "EXEC_SHELL",
          "GIT_WRITE",
          "DEPLOY",
          "NETWORK_ACCESS",
          "SECRET_ACCESS",
          "DB_WRITE"
        ]
      }
    }
  },
  "anyOf": [
    { "required": ["protectedBranches"] },
    { "required": ["approvalRequiredFor"] }
  ]
}
